+// ---------------------------------------------------------------------------------------------------------
+// Optional timing for hard-block <-> block RAM paths (celestica PCIe, 2026-11-02). Enabled only when the
+// environment variable NPNR_HARD_TIMING is set (other designs built with this binary are unchanged).
+// Without it PCIE_2_1 and RAMB18/36 pins are TMG_IGNORE: the 250 MHz paths between the PCIe block and its
+// TX/RX buffer RAMs (MIM*) are neither reported nor optimised by the router.
+//   PCIE_2_1: MIM{TX,RX}{WADDR,WDATA,WEN,RADDR,REN} = register outputs, MIM{TX,RX}RDATA = register inputs,
+//             clock USERCLK. Clock-to-out / setup are ASSUMED (no public per-pin numbers): 1.0 / 0.5 ns.
+//   RAMB36E1/RAMB18E1: port A pins on CLKARDCLK, port B pins on CLKBWRCLK (SDP: all DI on the write clock,
+//             all DO on the read clock). DS182-like -2 values: clock-to-out 0.65 ns (DO_REG) / 1.8 ns,
+//             setup 0.55 ns.
+static bool npnr_hard_timing()
+{
+    static int en = -1;
+    if (en < 0) {
+        const char *e = getenv("NPNR_HARD_TIMING");
+        en = (e != nullptr && *e != '\0' && *e != '0') ? 1 : 0;
+    }
+    return en == 1;
+}
+
+static bool str_starts(const std::string &s, const char *p) { return s.rfind(p, 0) == 0; }
+
+// 0 = not timed, 1 = register input, 2 = register output, 3 = clock input.
+// clk = clock port name, c2q / setup in ns.
+static int hard_port_timing(const Context *ctx, const CellInfo *cell, IdString port, IdString &clk, double &c2q,
+                            double &setup)
+{
+    if (!npnr_hard_timing())
+        return 0;
+    const std::string t = cell->type.str(ctx), p = port.str(ctx);
+    if (t == "PCIE_2_1_PCIE_2_1") {
+        clk = ctx->id("USERCLK");
+        c2q = 1.0;
+        setup = 0.5;
+        if (p == "USERCLK")
+            return 3;
+        if (str_starts(p, "MIMRXRDATA") || str_starts(p, "MIMTXRDATA"))
+            return 1;
+        if (str_starts(p, "MIMRXW") || str_starts(p, "MIMTXW") || str_starts(p, "MIMRXRADDR") ||
+            str_starts(p, "MIMTXRADDR") || p == "MIMRXREN" || p == "MIMTXREN")
+            return 2;
+        return 0;
+    }
+    bool is36 = (t == "RAMB36E1_RAMB36E1"), is18 = (t == "RAMB18E1_RAMB18E1");
+    if (!is36 && !is18)
+        return 0;
+    IdString clka = ctx->id(is36 ? "CLKARDCLKL" : "CLKARDCLK"), clkb = ctx->id(is36 ? "CLKBWRCLKL" : "CLKBWRCLK");
+    if (str_starts(p, "CLKARDCLK") || str_starts(p, "CLKBWRCLK"))
+        return 3;
+    auto mode = cell->params.find(ctx->id("RAM_MODE"));
+    bool sdp = mode != cell->params.end() && mode->second.is_string && mode->second.as_string() == "SDP";
+    setup = 0.55;
+    if (str_starts(p, "DOADO") || str_starts(p, "DOPADOP") || str_starts(p, "DOBDO") || str_starts(p, "DOPBDOP")) {
+        bool a = sdp || str_starts(p, "DOADO") || str_starts(p, "DOPADOP");
+        clk = a ? clka : clkb;
+        bool reg = int_or_default(cell->params, ctx->id(a ? "DOA_REG" : "DOB_REG"), 0) != 0;
+        c2q = reg ? 0.65 : 1.8;
+        return 2;
+    }
+    static const char *pa[] = {"ADDRARDADDR", "ENARDEN", "WEA", "REGCEAREGCE", "RSTRAMARSTRAM", "RSTREGARSTREG",
+                               "DIADI", "DIPADIP"};
+    static const char *pb[] = {"ADDRBWRADDR", "ENBWREN", "WEBWE", "REGCEB", "RSTRAMB", "RSTREGB", "DIBDI",
+                               "DIPBDIP"};
+    for (auto x : pa)
+        if (str_starts(p, x)) {
+            bool di = str_starts(p, "DIADI") || str_starts(p, "DIPADIP");
+            clk = (sdp && di) ? clkb : clka;
+            c2q = 0;
+            return 1;
+        }
+    for (auto x : pb)
+        if (str_starts(p, x)) {
+            clk = clkb;
+            c2q = 0;
+            return 1;
+        }
+    return 0;
+}
