set_property PACKAGE_PIN J3 [get_ports {pcie_rxn[1]}]
set_property PACKAGE_PIN K2 [get_ports {pcie_txp[2]}]
set_property PACKAGE_PIN K1 [get_ports {pcie_txn[2]}]
set_property PACKAGE_PIN K6 [get_ports {pcie_rxp[2]}]
set_property PACKAGE_PIN K5 [get_ports {pcie_rxn[2]}]
set_property PACKAGE_PIN M2 [get_ports {pcie_txp[3]}]
set_property PACKAGE_PIN M1 [get_ports {pcie_txn[3]}]
set_property PACKAGE_PIN L4 [get_ports {pcie_rxp[3]}]
set_property PACKAGE_PIN L3 [get_ports {pcie_rxn[3]}]
set_property PACKAGE_PIN N4 [get_ports {pcie_txp[4]}]
set_property PACKAGE_PIN N3 [get_ports {pcie_txn[4]}]
set_property PACKAGE_PIN M6 [get_ports {pcie_rxp[4]}]
set_property PACKAGE_PIN M5 [get_ports {pcie_rxn[4]}]
set_property PACKAGE_PIN P2 [get_ports {pcie_txp[5]}]
set_property PACKAGE_PIN P1 [get_ports {pcie_txn[5]}]
set_property PACKAGE_PIN P6 [get_ports {pcie_rxp[5]}]
set_property PACKAGE_PIN P5 [get_ports {pcie_rxn[5]}]
set_property PACKAGE_PIN T2 [get_ports {pcie_txp[6]}]
set_property PACKAGE_PIN T1 [get_ports {pcie_txn[6]}]
set_property PACKAGE_PIN R4 [get_ports {pcie_rxp[6]}]
set_property PACKAGE_PIN R3 [get_ports {pcie_rxn[6]}]
set_property PACKAGE_PIN U4 [get_ports {pcie_txp[7]}]
set_property PACKAGE_PIN U3 [get_ports {pcie_txn[7]}]
set_property PACKAGE_PIN T6 [get_ports {pcie_rxp[7]}]
